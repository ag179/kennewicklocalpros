---
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical: string;
  schemas?: object[];
}
const { title, description, canonical, schemas = [] } = Astro.props;
const footerLinks = [
  { slug: 'plumbing', name: 'Plumbing' },
  { slug: 'hvac', name: 'HVAC' },
  { slug: 'roofing', name: 'Roofing' },
  { slug: 'electrician', name: 'Electrician' },
  { slug: 'landscaping', name: 'Landscaping' },
  { slug: 'pestcontrol', name: 'Pest Control' },
  { slug: 'concrete', name: 'Concrete' },
  { slug: 'housecleaning', name: 'House Cleaning' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="bg-paper text-ink font-sans antialiased">
    <header class="site-header">
      <div class="max-w-6xl mx-auto px-5 h-[68px] flex items-center justify-between gap-5">
        <a href="/" class="flex items-center gap-2.5 font-serif font-bold text-[22px] sm:text-[25px] whitespace-nowrap no-underline">
          <svg viewBox="0 0 40 40" class="w-[30px] h-[30px] sm:w-[34px] sm:h-[34px] flex-none" aria-hidden="true">
            <rect width="40" height="40" rx="8" fill="#0F2238" />
            <path d="M9 28L14 9h2l5 19M21 28l5-19h2l5 19" fill="none" stroke="#E8C27C" stroke-width="1.8" stroke-linejoin="round" />
            <path d="M14 13L5 27M14 13l10 14M27 13l-8 14M27 13l9 14" stroke="#E8C27C" stroke-width=".8" fill="none" opacity=".8" />
            <path d="M4 31h32" stroke="#E8C27C" stroke-width="2" />
          </svg>
          {SITE.name}
        </a>
        <nav class="hidden md:flex gap-7 text-[15px] font-medium text-muted" aria-label="Main">
          <a href="/#trades" class="hover:text-ink">Browse trades</a>
          <a href="/#place" class="hover:text-ink">About the Tri-Cities</a>
          <a href="/#claim" class="hover:text-ink">For businesses</a>
        </nav>
        <a href="#quote" class="btn-brass hidden sm:inline-flex">Get free quotes</a>
      </div>
    </header>
    <slot />
    <footer class="bg-navy text-[#B7C0D0] mt-20 border-t border-[#20344F]">
      <div class="max-w-6xl mx-auto px-5 py-12 grid gap-9 md:grid-cols-[1.4fr_1fr_1fr] text-sm">
        <div>
          <p class="font-semibold text-[#EADFC8] mb-2">{SITE.name}</p>
          <p>
            A referral directory for {SITE.city}, {SITE.stateFull} and the surrounding Tri-Cities. We connect you with
            independent local providers; we do not perform the services listed and are not affiliated with any single
            contractor.
          </p>
          <a href="#quote" class="mt-3 inline-block text-[#E8C27C] font-semibold hover:text-white">Request a free quote</a>
        </div>
        <div>
          <p class="font-semibold text-[#EADFC8] mb-2">Popular services</p>
          <ul class="space-y-1">
            {footerLinks.map((l) => <li><a href={`/${l.slug}`} class="hover:text-white">{l.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="font-semibold text-[#EADFC8] mb-2">Directory</p>
          <ul class="space-y-1">
            <li><a href="/" class="hover:text-white">Home</a></li>
            <li><a href="/#claim" class="hover:text-white">Claim your listing</a></li>
            <li><a href="/sitemap.xml" class="hover:text-white">Sitemap</a></li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f1e6;
    --surface: #fffbf3;
    --ink: #14243a;
    --muted: #4f5e78;
    --line: #dccfb2;
    --brass: #7f5f20;
    --brass-fill: #c39a4b;
    --navy: #0f2238;
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0b1624;
      --surface: #122238;
      --ink: #f1e9d8;
      --muted: #a9b4c8;
      --line: #2a3c57;
      --brass: #ddb874;
      --brass-fill: #c39a4b;
      --navy: #0a1424;
      color-scheme: dark;
    }
  }
  html {
    scroll-padding-top: calc(env(safe-area-inset-top, 0px) + 84px);
  }
  body {
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  h1, h2, h3 {
    font-family: 'Cormorant Garamond', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  :focus-visible {
    outline: 3px solid var(--brass-fill);
    outline-offset: 2px;
    border-radius: 3px;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top, 0px);
  }
  .btn-brass,
  .btn-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font: 600 15px/1 'Hanken Grotesk', system-ui, sans-serif;
    text-decoration: none;
    border-radius: 6px;
    padding: 13px 20px;
    border: 1px solid transparent;
    cursor: pointer;
    white-space: nowrap;
  }
  .btn-brass { background: var(--brass-fill); color: #14243a; }
  .btn-brass:hover { background: #d2a95a; }
  .btn-line { border-color: var(--line); color: var(--ink); background: transparent; }
  .btn-line:hover { border-color: var(--brass-fill); }
  .btn-sm { padding: 10px 14px; font-size: 14px; }
  .chip {
    font: 500 14px 'Hanken Grotesk', system-ui, sans-serif;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 14px;
    cursor: pointer;
  }
  .chip:hover { border-color: var(--brass-fill); }
  .chip[aria-pressed='true'] { background: var(--navy); border-color: var(--navy); color: #f3e7cc; }
  @media (prefers-color-scheme: dark) {
    .chip[aria-pressed='true'] { background: #e6d3a5; border-color: #e6d3a5; color: #0f2238; }
  }
</style>
