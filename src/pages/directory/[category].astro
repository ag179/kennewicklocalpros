---
import Layout from '../../layouts/Layout.astro';
import DirectoryListing from '../../components/DirectoryListing.tsx';
import { SITE } from '../../lib/site';
import { directoryCategories } from '../../lib/supabase';
import { localBusinessSchema } from '../../lib/schema';

export function getStaticPaths() {
  return directoryCategories.map((c) => ({
    params: { category: c.slug },
    props: { categorySlug: c.slug, categoryLabel: c.label, serviceSlug: c.serviceSlug },
  }));
}

const { categorySlug, categoryLabel, serviceSlug } = Astro.props;
const title = `${categoryLabel} in ${SITE.city}, ${SITE.state} — Local Pros Directory`;
const description = `Browse trusted ${categoryLabel.toLowerCase()} businesses serving ${SITE.city}, WA. Compare services, ratings, and contact info — then connect directly.`;
const canonical = `${SITE.domain}/directory/${categorySlug}`;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  schemas={[localBusinessSchema()]}
>
  <main class="max-w-5xl mx-auto px-4">
    <nav class="text-xs text-stone-500 mt-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-sky-700">Home</a>
      <span class="mx-1">›</span>
      <span>Directory</span>
      <span class="mx-1">›</span>
      <span class="text-stone-700">{categoryLabel}</span>
    </nav>

    <section class="py-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900">
        {categoryLabel} businesses in {SITE.city}, {SITE.state}
      </h1>
      <p class="mt-3 max-w-2xl text-stone-700 leading-relaxed">
        These are independent {categoryLabel.toLowerCase()} providers serving the Kennewick area.
        Browse their profiles, compare services and ratings, and reach out directly — no middleman,
        no fee.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={`/${serviceSlug}`}
          class="text-sm font-semibold text-sky-700 hover:text-sky-800 underline"
        >
          Learn about {categoryLabel.toLowerCase()} services in {SITE.city}
        </a>
        <span class="text-stone-300">|</span>
        <a href="/directory" class="text-sm font-semibold text-sky-700 hover:text-sky-800 underline">
          All directory categories
        </a>
      </div>
    </section>

    <section class="pb-12">
      <DirectoryListing client:load category={categorySlug} categoryLabel={categoryLabel} domain={SITE.domain} />
    </section>
  </main>
</Layout>
