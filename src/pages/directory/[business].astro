---
import Layout from '../../layouts/Layout.astro';
import BusinessDetail from '../../components/BusinessDetail.tsx';
import { SITE } from '../../lib/site';
import { supabase } from '../../lib/supabase';
import { localBusinessSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const { data } = await supabase.from('kennewick').select('slug, category, category_label, name');
  const businesses = data ?? [];
  return businesses.map((b) => ({
    params: { business: b.slug },
    props: { slug: b.slug, name: b.name, category: b.category, categoryLabel: b.category_label },
  }));
}

const { slug, name, category, categoryLabel } = Astro.props;
const title = `${name} — ${categoryLabel} in ${SITE.city}, WA`;
const description = `${name} is a ${categoryLabel.toLowerCase()} business serving ${SITE.city}, WA. See services, contact info, hours, and ratings.`;
const canonical = `${SITE.domain}/directory/${slug}`;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  schemas={[localBusinessSchema()]}
>
  <BusinessDetail client:load slug={slug} domain={SITE.domain} city={SITE.city} />
</Layout>
