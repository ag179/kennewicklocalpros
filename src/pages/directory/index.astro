---
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../lib/site';
import { directoryCategories } from '../../lib/supabase';
import { localBusinessSchema } from '../../lib/schema';

const title = `Local Business Directory — ${SITE.name}`;
const description = `Browse trusted local businesses in ${SITE.city}, WA. Find catering, pest control, house cleaning, and more.`;
const canonical = `${SITE.domain}/directory`;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  schemas={[localBusinessSchema()]}
>
  <main class="max-w-5xl mx-auto px-4">
    <nav class="text-xs text-stone-500 mt-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-sky-700">Home</a>
      <span class="mx-1">›</span>
      <span class="text-stone-700">Directory</span>
    </nav>

    <section class="py-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-stone-900">
        Local business directory for {SITE.city}, {SITE.state}
      </h1>
      <p class="mt-3 max-w-2xl text-stone-700 leading-relaxed">
        Browse vetted local businesses by category. Each listing has its own page with full details,
        services, contact info, and ratings.
      </p>
    </section>

    <section class="pb-12">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {directoryCategories.map((c) => (
          <a
            href={`/directory/${c.slug}`}
            class="group bg-white border border-stone-200 rounded-2xl p-6 hover:border-sky-400 hover:shadow-lg transition-all duration-200"
          >
            <div class="flex items-center justify-between">
              <h2 class="text-xl font-bold text-stone-900 group-hover:text-sky-700 transition-colors">
                {c.label}
              </h2>
              <svg class="w-5 h-5 text-stone-400 group-hover:text-sky-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </div>
            <p class="mt-2 text-sm text-stone-600">
              Browse {c.label.toLowerCase()} businesses serving {SITE.city} and the Tri-Cities area.
            </p>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
