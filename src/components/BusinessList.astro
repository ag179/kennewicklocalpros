---
import type { LocalBusiness } from '../data/businesses';

interface Props {
  businesses: LocalBusiness[];
  serviceName: string;
  serviceSlug: string;
  city: string;
}
const { businesses, serviceName, serviceSlug, city } = Astro.props;
const telHref = (p: string) => `tel:+1${p.replace(/\D/g, '')}`;
---
<section class="mt-10" id="local-businesses">
  <h2 class="text-2xl font-bold text-stone-900">{serviceName} companies in {city} and the Tri-Cities</h2>
  <p class="mt-2 text-sm text-stone-600 leading-relaxed">
    {businesses.length} local {serviceName.toLowerCase()} providers, ranked by Google rating weighted by number of reviews{businesses.some((b) => b.featured) ? ', with featured providers first' : ''}.
    Listings are independent businesses. Contact them directly.
  </p>
  <ol class="mt-5 grid gap-4 sm:grid-cols-2">
    {businesses.map((b) => (
      <li
        class={b.featured
          ? 'relative bg-amber-50 border-2 border-amber-400 rounded-xl p-5 flex flex-col shadow-md shadow-amber-100 sm:col-span-2'
          : 'bg-white border border-stone-200 rounded-xl p-5 flex flex-col hover:border-sky-400 transition-colors'}
      >
        {b.featured && (
          <span class="self-start mb-2 inline-flex items-center gap-1 bg-amber-400 text-amber-950 text-xs font-bold uppercase tracking-wide px-2.5 py-1 rounded-full">
            ★ Featured
          </span>
        )}
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-semibold text-stone-900 leading-snug">
            <a href={`/${serviceSlug}/${b.slug}`} class="hover:text-sky-700">{b.name}</a>
          </h3>
          {b.rating !== null && b.reviews > 0 && (
            <span class="flex-none text-sm whitespace-nowrap">
              <span class="font-bold text-amber-600">★ {b.rating.toFixed(1)}</span>
              <span class="text-stone-400"> ({b.reviews.toLocaleString('en-US')})</span>
            </span>
          )}
        </div>
        <p class="mt-2 text-sm text-stone-600">{b.address}</p>
        {b.hours && <p class="mt-1 text-xs text-stone-500">{b.hours}</p>}
        <div class="mt-auto pt-4 flex flex-wrap gap-x-4 gap-y-2 text-sm font-semibold">
          {b.phone && <a href={telHref(b.phone)} class="text-sky-700 hover:text-sky-800">{b.phone}</a>}
          <a href={`/${serviceSlug}/${b.slug}`} class="text-sky-700 hover:text-sky-800">View profile</a>
          {b.website && (
            <a href={b.website} target="_blank" rel="noopener nofollow" class="text-stone-500 hover:text-stone-700">Website</a>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>
