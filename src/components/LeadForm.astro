---
// Quote request form. Submissions are saved to Supabase (table site_leads) and show up in /admin → Leads.
// Visitors can only add a lead; they can never read other people's requests (enforced by the database).
import { SITE } from '../lib/site';

interface Props {
  serviceName: string;
  serviceSlug?: string;
  /** DOM id / anchor of the form section. Defaults to "quote". */
  id?: string;
  /** 'claim' turns the form into a "claim this listing" request (saved to site_leads with service "claim-listing"). */
  mode?: 'quote' | 'claim';
  businessName?: string;
}
const { serviceName, serviceSlug, id = 'quote', mode = 'quote', businessName } = Astro.props;
const isGeneral = serviceName === 'General';
const isClaim = mode === 'claim';
const heading = isClaim
  ? businessName
    ? `Claim the listing for ${businessName}`
    : 'Claim your business listing'
  : isGeneral
    ? `Get a free quote in ${SITE.city}`
    : `Get a free ${serviceName.toLowerCase()} quote in ${SITE.city}`;
const blurb = isClaim
  ? 'Tell us who you are and how to reach you. We will verify ownership and then let you add photos, services and your service area.'
  : "Tell us what you need and we'll match you with a local pro. We'll reply by email.";
const placeholder = isClaim ? (businessName ? 'Anything we should know?' : 'Business name and the trade you are listed under') : 'What do you need done?';
const button = isClaim ? 'Request to claim' : 'Request my free quote';
const leadService = isClaim ? 'claim-listing' : (serviceSlug ?? (isGeneral ? 'general' : serviceName));
const prefix = isClaim && businessName ? `[Claim: ${businessName}${serviceSlug ? ' / ' + serviceSlug : ''}] ` : '';
---
<section id={id} class="scroll-mt-24 bg-surface border border-line rounded-md p-6 sm:p-8">
  <h2 class="text-3xl sm:text-4xl">{heading}</h2>
  <p class="mt-2 text-sm text-muted">{blurb}</p>
  <form
    data-lead-form
    data-url={SITE.listingsDb.url}
    data-key={SITE.listingsDb.anonKey}
    data-site={SITE.listingsDb.site}
    data-service={leadService}
    data-prefix={prefix}
    class="mt-4 grid gap-3 sm:grid-cols-2"
    novalidate
  >
    <input type="text" name="name" required maxlength="200" autocomplete="name" placeholder="Your name" class="rounded-md border border-line bg-paper text-ink px-3 py-2.5 text-sm" />
    <input type="email" name="email" required maxlength="320" autocomplete="email" placeholder="Email" class="rounded-md border border-line bg-paper text-ink px-3 py-2.5 text-sm" />
    <input type="tel" name="phone" maxlength="50" autocomplete="tel" placeholder="Phone (optional)" class="rounded-md border border-line bg-paper text-ink px-3 py-2.5 text-sm sm:col-span-2" />
    <textarea name="message" rows="3" maxlength="5000" placeholder={placeholder} class="rounded-md border border-line bg-paper text-ink px-3 py-2.5 text-sm sm:col-span-2"></textarea>
    <!-- Spam trap: hidden from people, bots tend to fill it in -->
    <div aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden">
      <label>Leave this empty <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>
    <button type="submit" class="sm:col-span-2 btn-brass disabled:opacity-60">
      {button}
    </button>
    <p data-status role="status" class="sm:col-span-2 text-sm hidden"></p>
  </form>
  <noscript><p class="mt-3 text-sm text-muted">Please enable JavaScript to send the form.</p></noscript>
</section>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

  document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    const show = (text: string, ok: boolean) => {
      status.textContent = text;
      status.className = `sm:col-span-2 text-sm ${ok ? 'text-brass font-semibold' : 'text-red-700'}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const value = (k: string) => String(data.get(k) ?? '').trim();

      if (value('company_website')) return show('Thanks! Your request has been sent.', true); // bot
      if (!value('name')) return show('Please enter your name.', false);
      if (!EMAIL.test(value('email'))) return show('Please enter a valid email address.', false);

      const { url, key, site, service, prefix } = form.dataset;
      const lead = {
        site,
        service,
        page: window.location.pathname,
        name: value('name'),
        email: value('email'),
        phone: value('phone') || null,
        message: ((prefix ?? '') + value('message')).trim() || null,
      };

      button.disabled = true;
      show('Sending…', true);
      try {
        const res = await fetch(`${url}/rest/v1/site_leads`, {
          method: 'POST',
          headers: {
            apikey: key!,
            Authorization: `Bearer ${key}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify(lead),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        show("Thanks! Your request has been sent. We'll get back to you by email shortly.", true);
      } catch {
        show('Sorry, something went wrong sending your request. Please try again in a minute.', false);
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
